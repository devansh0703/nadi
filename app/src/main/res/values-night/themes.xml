<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The app is light-only (see ui/theme/Theme.kt), so the night variant
         matches the day variant: no dark chrome, no surprise inversion when the
         system switches to dark mode. -->
    <style name="Theme.Nadi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#B31E33</item>
        <item name="colorPrimaryVariant">#8F1128</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#77565A</item>
        <item name="colorSecondaryVariant">#524446</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">#B31E33</item>

        <item name="android:windowBackground">#FFF7F6</item>
        <item name="android:statusBarColor">#FFF7F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="26">true</item>
    </style>
</resources>
