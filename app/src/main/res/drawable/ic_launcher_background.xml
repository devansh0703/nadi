<?xml version="1.0" encoding="utf-8"?>
<!--
  Nadi launcher icon background — Metrolist coral.
  Deep coral base (#B31E33 → #ED5564) matching the app's light Material theme,
  with a warm blush glow behind the pulse mark so the icon reads as "alive"
  without any bitmap asset.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base: diagonal coral gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FFB31E33" android:offset="0.0" />
                <item android:color="#FFED5564" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiance: faint warm-white halo centred on the pulse -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48">
                <item android:color="#40FFFFFF" android:offset="0.0" />
                <item android:color="#1AFFFFFF" android:offset="0.55" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
