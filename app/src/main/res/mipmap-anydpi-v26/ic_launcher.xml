<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. References the vector drawables directly (not the
  mipmap bitmaps) so the Nadi mark is generated from vectors at every density.
  minSdk is 26, so this adaptive definition is always the one that applies.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+): launcher tints this layer -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
